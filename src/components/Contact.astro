---
import SectionHeading from './SectionHeading.astro';
import { ContactForm } from './react/ContactForm';
---

<section id="contacto" class="py-20 md:py-28 relative ambient-section ambient-section--reverse">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Contacto Directo"
      title="¿Construimos algo juntos?"
      subtitle="¿Tienes un proyecto en mente o buscas un desarrollador Senior Full Stack & Mobile para tu equipo? Platiquemos."
    />

    <ContactForm client:visible />
  </div>
</section>
