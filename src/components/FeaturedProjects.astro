---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<section id="proyectos" class="py-20 md:py-28 relative ambient-section wave-section bg-gradient-to-br from-violet-50/60 via-blue-50/40 to-cyan-50/60 dark:from-violet-950/20 dark:via-blue-950/10 dark:to-cyan-950/15 border-y border-violet-200/40 dark:border-violet-800/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Portafolio de Proyectos"
      title="Casos de estudio y soluciones destacadas"
      subtitle="Plataformas SaaS, soluciones móviles híbridas y sistemas empresariales desarrollados con estándares de nivel senior."
    />

    <div class="flex flex-col gap-10">
      {/* Featured Large Project (First Project) */}
      {sortedProjects.length > 0 && (
        <ProjectCard project={sortedProjects[0]} isFeaturedLarge={true} />
      )}

      {/* Grid of Remaining Projects */}
      {sortedProjects.length > 1 && (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {sortedProjects.slice(1).map((project) => (
            <ProjectCard project={project} isFeaturedLarge={false} />
          ))}
        </div>
      )}
    </div>
  </div>
</section>
