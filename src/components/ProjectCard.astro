---
import { ShieldAlert, ArrowRight } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  isFeaturedLarge?: boolean;
}

const { project, isFeaturedLarge = false } = Astro.props;
const { data, id } = project;
---

<div
  class={`group relative rounded-3xl glass-card overflow-hidden shadow-xl hover:shadow-2xl hover:border-blue-500/60 transition-all duration-300 flex flex-col ${
    isFeaturedLarge ? 'lg:grid lg:grid-cols-12 lg:items-center' : ''
  }`}
>
  <!-- Card Image / Mockup -->
  <div
    class={`relative overflow-hidden bg-slate-950 ${
      isFeaturedLarge ? 'lg:col-span-7 h-64 sm:h-80 lg:h-full min-h-[320px]' : 'h-60 sm:h-64'
    }`}
  >
    <img
      src={data.image}
      alt={data.title}
      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    
    <!-- Image Overlay Gradient -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent pointer-events-none"></div>

    <!-- Status & Confidentiality Badges -->
    <div class="absolute top-4 left-4 right-4 flex flex-wrap items-start justify-between gap-2 z-10">
      <span class="max-w-full px-3 py-1 text-[11px] sm:text-xs font-mono font-semibold rounded-full bg-slate-950/80 text-white backdrop-blur-md border border-white/10 shadow-md break-words">
        {data.status}
      </span>

      {data.isConfidential && (
        <span class="flex items-center gap-1.5 px-3 py-1 text-xs font-mono font-bold rounded-full bg-red-600 text-white shadow-md">
          <ShieldAlert className="w-3.5 h-3.5" />
          <span>Confidencial</span>
        </span>
      )}
    </div>
  </div>

  <!-- Card Body -->
  <div
    class={`p-6 sm:p-8 flex flex-col justify-between gap-6 ${
      isFeaturedLarge ? 'lg:col-span-5' : 'flex-1'
    }`}
  >
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider">
          {data.category}
        </span>
      </div>

      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        {data.title}
      </h3>

      <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3">
        {data.summary}
      </p>
    </div>

    <!-- Tech Stack -->
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap gap-1.5">
        {data.technologies.slice(0, 5).map((tech) => (
          <span
            class="px-2.5 py-1 text-[11px] font-mono rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60"
          >
            {tech}
          </span>
        ))}
        {data.technologies.length > 5 && (
          <span class="px-2 py-1 text-[10px] font-mono text-slate-400">
            +{data.technologies.length - 5}
          </span>
        )}
      </div>

      <!-- Action Link -->
      <a
        href={`/proyectos/${id}`}
        class="inline-flex items-center gap-2 text-sm font-bold text-blue-600 dark:text-blue-400 hover:text-blue-500 group/link transition-colors pt-2 border-t border-slate-100 dark:border-slate-800"
      >
        <span>Ver caso de estudio</span>
        <ArrowRight className="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>
</div>
