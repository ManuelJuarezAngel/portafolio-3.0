---
const techStackTags = [
  { name: "Laravel", color: "bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/20" },
  { name: "React", color: "bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20" },
  { name: "Vue.js", color: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20" },
  { name: "Ionic", color: "bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border-cyan-500/20" },
  { name: "MySQL", color: "bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20" },
  { name: "WebSockets", color: "bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20" },
  { name: "APIs REST", color: "bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20" },
  { name: "Mobile", color: "bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/20" },
  { name: "Cloud", color: "bg-sky-500/10 text-sky-600 dark:text-sky-400 border-sky-500/20" },
];
---

<div class="relative w-full max-w-lg mx-auto hero-visual-depth" data-hero-tilt data-parallax data-parallax-speed="-0.08">
  <!-- Glowing Background Ambient Spheres -->
  <div class="absolute -top-12 -left-12 w-64 h-64 bg-blue-500/20 rounded-full blur-3xl animate-pulse-glow pointer-events-none" data-parallax data-parallax-speed="0.2"></div>
  <div class="absolute -bottom-12 -right-12 w-64 h-64 bg-purple-500/20 rounded-full blur-3xl animate-pulse-glow pointer-events-none" data-parallax data-parallax-speed="-0.16"></div>

  <!-- Tech Card Container -->
  <div class="hero-code-card relative rounded-3xl bg-white/90 dark:bg-slate-900/90 border border-slate-200/80 dark:border-slate-800/80 shadow-2xl p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:border-blue-500/40">
    
    <!-- Header Mac OS Style Bar -->
    <div class="flex items-center justify-between pb-4 mb-6 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
      </div>
      <span class="text-xs font-mono text-slate-500 dark:text-slate-400">developer.ts</span>
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[10px] font-mono">
        <span>Active</span>
      </div>
    </div>

    <!-- Code Block -->
    <div class="p-4 sm:p-5 rounded-2xl bg-slate-950 text-slate-100 font-mono text-xs sm:text-sm overflow-x-auto shadow-inner border border-slate-800 leading-relaxed mb-6">
      <div class="flex gap-3">
        <span class="text-slate-600 select-none">1</span>
        <span><span class="text-purple-400">const</span> <span class="text-blue-400">developer</span> = &#123;</span>
      </div>
      <div class="flex gap-3">
        <span class="text-slate-600 select-none">2</span>
        <span class="pl-4"><span class="text-sky-300">name</span>: <span class="text-emerald-400">"Manuel Juárez"</span>,</span>
      </div>
      <div class="flex gap-3">
        <span class="text-slate-600 select-none">3</span>
        <span class="pl-4"><span class="text-sky-300">role</span>: <span class="text-emerald-400">"Full Stack &amp; Mobile"</span>,</span>
      </div>
      <div class="flex gap-3">
        <span class="text-slate-600 select-none">4</span>
        <span class="pl-4"><span class="text-sky-300">experience</span>: <span class="text-emerald-400">"5+ años"</span>,</span>
      </div>
      <div class="flex gap-3">
        <span class="text-slate-600 select-none">5</span>
        <span class="pl-4"><span class="text-sky-300">focus</span>: [<span class="text-emerald-400">"Web"</span>, <span class="text-emerald-400">"Mobile"</span>, <span class="text-emerald-400">"SaaS"</span>]</span>
      </div>
      <div class="flex gap-3">
        <span class="text-slate-600 select-none">6</span>
        <span>&#125;;</span>
      </div>
    </div>

    <!-- Tech Stack Tags Cloud -->
    <div class="flex flex-col gap-3">
      <span class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold">
        Stack Principal
      </span>
      <div class="flex flex-wrap gap-2">
        {techStackTags.map((tech) => (
          <span
            class={`px-3 py-1 text-xs font-mono font-medium rounded-lg border transition-transform duration-200 hover:scale-105 ${tech.color}`}
          >
            {tech.name}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>
