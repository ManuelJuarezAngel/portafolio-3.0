---
import { stats } from '../data/portfolioData';
import { Award, Smartphone, Store, Zap, TrendingUp, Layers } from 'lucide-react';

const icons = [Award, Smartphone, Store, Zap, TrendingUp, Layers];
---

<section class="relative py-10 bg-slate-100/50 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-6">
      {stats.map((stat, idx) => {
        const IconComponent = icons[idx % icons.length];
        return (
          <div
            class="flex flex-col items-center text-center p-3 sm:p-4 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800/80 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-blue-500/30 min-w-0"
          >
            <div class="p-2.5 rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 mb-2">
              <IconComponent className="w-5 h-5" />
            </div>
            <span class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
              {stat.value}
            </span>
            <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 mt-1">
              {stat.label}
            </span>
            {stat.description && (
              <span class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5 leading-snug">
                {stat.description}
              </span>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
