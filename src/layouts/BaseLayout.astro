---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { personalInfo } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = `${personalInfo.name} | ${personalInfo.role}`,
  description = personalInfo.description,
  image = "/images/og-image.jpg",
  canonicalUrl = Astro.url.href,
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": personalInfo.name,
  "jobTitle": personalInfo.role,
  "description": personalInfo.description,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Naucalpan",
    "addressRegion": "Estado de México",
    "addressCountry": "México"
  },
  "email": personalInfo.email,
  "telephone": personalInfo.phone,
  "sameAs": [
    personalInfo.linkedin,
    personalInfo.github
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={personalInfo.name} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Inline Script to prevent Theme Flash on Load -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('mj-portfolio-theme');
          const root = document.documentElement;
          if (savedTheme === 'light') {
            root.classList.remove('dark');
            root.classList.add('light');
          } else if (savedTheme === 'system') {
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
              root.classList.add('dark');
              root.classList.remove('light');
            } else {
              root.classList.remove('dark');
              root.classList.add('light');
            }
          } else {
            // Default is dark mode per requirements
            root.classList.add('dark');
            root.classList.remove('light');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-[#07090e] text-slate-900 dark:text-slate-100 selection:bg-blue-500 selection:text-white transition-colors duration-300">
    <div class="parallax-aurora" aria-hidden="true">
      <span class="parallax-aurora__orb parallax-aurora__orb--blue"></span>
      <span class="parallax-aurora__orb parallax-aurora__orb--violet"></span>
      <span class="parallax-aurora__orb parallax-aurora__orb--cyan"></span>
    </div>
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-blue-600 text-white font-bold rounded-lg shadow-lg"
    >
      Saltar al contenido principal
    </a>

    <slot />

    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const lightweightViewport = window.matchMedia('(max-width: 639px), (pointer: coarse)');
        let parallaxItems = [];
        let auroraItems = [];
        let ticking = false;

        const renderParallax = () => {
          const scrollY = window.scrollY;
          parallaxItems.forEach((item) => {
            const speed = Number(item.dataset.parallaxSpeed || 0.08);
            item.style.setProperty('--parallax-y', `${scrollY * speed}px`);
          });
          const factors = [0.04, -0.075, 0.055];
          auroraItems.forEach((item, index) => {
            item.style.setProperty('--aurora-shift', `${scrollY * factors[index]}px`);
          });
          ticking = false;
        };

        const requestParallax = () => {
          if (ticking || reduceMotion.matches || lightweightViewport.matches) return;
          ticking = true;
          requestAnimationFrame(renderParallax);
        };

        const initMotion = () => {
          parallaxItems = [...document.querySelectorAll('[data-parallax]')];
          auroraItems = [...document.querySelectorAll('.parallax-aurora__orb')];
          requestParallax();

          document.querySelectorAll('[data-hero-tilt]').forEach((visual) => {
            if (visual.dataset.tiltReady || reduceMotion.matches || !window.matchMedia('(pointer: fine)').matches) return;
            visual.dataset.tiltReady = 'true';
            const card = visual.querySelector('.hero-code-card');
            visual.addEventListener('pointermove', (event) => {
              const rect = visual.getBoundingClientRect();
              const x = (event.clientX - rect.left) / rect.width;
              const y = (event.clientY - rect.top) / rect.height;
              card.style.setProperty('--tilt-x', `${(x - 0.5) * 8}deg`);
              card.style.setProperty('--tilt-y', `${(0.5 - y) * 8}deg`);
              card.style.setProperty('--pointer-x', `${x * 100}%`);
              card.style.setProperty('--pointer-y', `${y * 100}%`);
              card.style.setProperty('--tilt-glow', '1');
            });
            visual.addEventListener('pointerleave', () => {
              card.style.setProperty('--tilt-x', '0deg');
              card.style.setProperty('--tilt-y', '0deg');
              card.style.setProperty('--tilt-glow', '0');
            });
          });

          document.querySelectorAll('#hero .lg\\:col-span-7 > *, #hero .lg\\:col-span-5').forEach((item, index) => {
            if (item.dataset.motionReady) return;
            item.dataset.motionReady = 'true';
            item.classList.add('hero-load-item');
            item.style.setProperty('--hero-delay', `${80 + index * 90}ms`);
          });

          const candidates = document.querySelectorAll([
            'section:not(#hero) [data-section-heading]',
            'section:not(#hero):not(#tecnologias) .glass-card',
            '#experiencia button',
            '#contacto form'
          ].join(','));

          if (reduceMotion.matches || !('IntersectionObserver' in window)) {
            candidates.forEach((item) => item.classList.add('is-visible'));
            return;
          }

          const observer = new IntersectionObserver((entries, currentObserver) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              currentObserver.unobserve(entry.target);
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

          candidates.forEach((item, index) => {
            if (item.dataset.revealReady) return;
            item.dataset.revealReady = 'true';
            item.classList.add('reveal-item');
            item.dataset.reveal = index % 4 === 0 ? 'left' : index % 4 === 3 ? 'right' : 'up';
            item.style.setProperty('--reveal-delay', `${(index % 4) * 70}ms`);
            observer.observe(item);
          });
        };

        document.addEventListener('astro:page-load', initMotion);
        window.addEventListener('scroll', requestParallax, { passive: true });
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMotion, { once: true });
        } else {
          initMotion();
        }
      })();
    </script>
  </body>
</html>
