---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/react/Navbar';
import Footer from '../components/Footer.astro';
import { Home } from 'lucide-react';
---

<BaseLayout title="Página no encontrada (404) | Manuel Juárez">
  <Navbar client:load />

  <main id="main-content" class="min-h-[80vh] flex items-center justify-center pt-32 pb-20 relative">
    <div class="max-w-md mx-auto px-4 text-center flex flex-col items-center gap-6">
      <div class="w-24 h-24 rounded-3xl bg-blue-500/10 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400 flex items-center justify-center font-mono text-4xl font-extrabold border border-blue-500/30">
        404
      </div>

      <div class="flex flex-col gap-2">
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">
          Página no encontrada
        </h1>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
          La ruta que estás buscando no existe o ha sido movida.
        </p>
      </div>

      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 rounded-2xl transition-all shadow-lg shadow-blue-500/20"
      >
        <Home className="w-4 h-4" />
        <span>Volver al inicio</span>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
