---
import SectionHeading from './SectionHeading.astro';
import { education } from '../data/portfolioData';
import { GraduationCap, Award, Calendar, CheckCircle2 } from 'lucide-react';
---

<section class="py-20 md:py-28 relative ambient-section wave-section bg-gradient-to-br from-cyan-50/60 via-blue-50/40 to-violet-50/50 dark:from-cyan-950/15 dark:via-blue-950/10 dark:to-violet-950/15 border-y border-cyan-200/40 dark:border-cyan-800/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Formación Académica"
      title="Educación y certificaciones"
      subtitle="Base sólida en ingeniería de sistemas computacionales y especialización continua en tecnologías móviles."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {education.map((item) => (
        <div
          class="p-5 sm:p-8 rounded-3xl glass-card shadow-lg flex flex-col justify-between gap-6 hover:border-blue-500/50 transition-all min-w-0"
        >
          <div class="flex flex-col gap-4">
            <div class="flex items-center justify-between">
              <div class="p-3 rounded-2xl bg-blue-500/10 dark:bg-blue-500/15 text-blue-600 dark:text-blue-400">
                {item.isCertification ? <Award className="w-6 h-6" /> : <GraduationCap className="w-6 h-6" />}
              </div>
              <span class="flex items-center gap-1.5 text-xs font-mono font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-3 py-1 rounded-full">
                <Calendar className="w-3.5 h-3.5 text-blue-500" />
                {item.period}
              </span>
            </div>

            <h4 class="text-xl font-bold text-slate-900 dark:text-white">
              {item.title}
            </h4>

            <p class="text-sm font-semibold text-blue-600 dark:text-blue-400">
              {item.institution}
            </p>
          </div>

          {item.status && (
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400">
              <CheckCircle2 className="w-4 h-4" />
              <span>{item.status}</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
