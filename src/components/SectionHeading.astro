---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { badge, title, subtitle, centered = true } = Astro.props;
---

<div data-section-heading class={`flex flex-col gap-3 ${centered ? 'items-center text-center' : 'items-start text-left'} mb-12 sm:mb-16`}>
  {badge && (
    <span class="px-3.5 py-1 text-xs font-mono font-semibold uppercase tracking-widest text-blue-600 dark:text-blue-400 bg-blue-500/10 dark:bg-blue-500/15 rounded-full border border-blue-500/20">
      {badge}
    </span>
  )}
  <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl font-normal leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
